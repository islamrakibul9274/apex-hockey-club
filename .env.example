# ---------------------------------------------------------------------------
# Apex Hockey Club — environment configuration
#
# Copy to `.env.local` and fill in. Never commit a real .env.local.
#
# REQUIRED — the app refuses to authenticate without these. There is no
# fallback value for AUTH_SECRET on purpose: a hardcoded default would live in
# this public repository and let anyone mint a session for any account.
# ---------------------------------------------------------------------------

# Signs and verifies session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""

# MongoDB Atlas connection string.
MONGODB_URI=""

# Canonical origin. Used for password-reset links and checkout redirects.
# Production value: https://apex-hockey-club.netlify.app
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# OPTIONAL — the features below degrade gracefully when unset.
# ---------------------------------------------------------------------------

# --- Stripe (memberships, tickets, store checkout) --------------------------
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Groq AI coach ----------------------------------------------------------
# Without this the coach endpoint returns a helpful "not configured" reply.
GROQ_API_KEY=""

# --- Resend (contact form + password-reset email) ---------------------------
# Without this, reset links are written to the server log instead of emailed.
RESEND_API_KEY=""

# --- Cloudinary (uploads) ---------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Pusher (real-time booking updates) ------------------------------------
PUSHER_APP_ID=""
NEXT_PUBLIC_PUSHER_KEY=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"